# =============================================================================
# GIS Intake 28 Welfare Portal — Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# --- Application ---
NEXT_PUBLIC_APP_NAME="GIS Intake 28 Welfare Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Firebase Web SDK (Client) ---
# Firebase Console → Project Settings → General → Your apps → Web app
# Click "Config" to reveal the firebaseConfig object and map each value below.
#
#   apiKey            → NEXT_PUBLIC_FIREBASE_API_KEY
#   authDomain        → NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   projectId         → NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   storageBucket     → NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
#   messagingSenderId → NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   appId             → NEXT_PUBLIC_FIREBASE_APP_ID
#
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase App Check (client) ---
# Production: reCAPTCHA Enterprise site key (Google Cloud → reCAPTCHA Enterprise).
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
#
# Development only (never set in production / never commit real tokens):
# Optional registered App Check debug token for localhost + LAN / other Wi‑Fi devices.
# 1) Run `next dev`, open the browser console, copy the App Check debug token Firebase prints.
# 2) Firebase Console → App Check → Apps → ⋮ → Manage debug tokens → register it.
# 3) Put that token here so phones on 192.168.x.x can reuse the same safelisted token.
# If unset in development, the app sets FIREBASE_APPCHECK_DEBUG_TOKEN=true (per-browser token).
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# --- Firebase Admin (server-only — service account JSON) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PROFILE_PHOTO_STORAGE_ENABLED=true
NEXT_PUBLIC_PROFILE_PHOTO_STORAGE_ENABLED=true

# --- Activation session (server-only — min 32 characters) ---
ACTIVATION_SESSION_SECRET=

# --- Online payments (Hubtel Online Checkout) ---
# New online checkouts are allowed only when exactly "true" (fail-closed).
# Member online checkout is unavailable when false/omitted (fail-closed).
PAYMENTS_ENABLED=false
# Server-only Hubtel Payment API (Basic Auth). Never use NEXT_PUBLIC_* for these.
HUBTEL_PAYMENT_API_ID=
HUBTEL_PAYMENT_API_KEY=
# Optional — defaults to the configured Accra collection account when omitted
HUBTEL_COLLECTION_ACCOUNT_NUMBER=

# --- Paystack (historical verify/recovery only; not used for new checkouts) ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Optional — domain for synthetic member payment emails (defaults to app hostname or gis28welfare.org)
PAYMENT_EMAIL_DOMAIN=

# --- Hubtel (OTP / SMS) — separate from Payment API credentials ---
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=

# --- Cron (Vercel Cron → /api/cron/progression-month-boundary) ---
# Vercel sends Authorization: Bearer <CRON_SECRET>. Required in production.
CRON_SECRET=
